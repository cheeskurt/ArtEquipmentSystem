@model WebApplication3.Models.Stock

@{
    ViewData["Title"] = "Edit";
}

<h1 class="center">Edit</h1>

<h4 class="center">Stock</h4>

<div class="row">
    <div class="col-md-4 center">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="StockID" />
            <div class="form-group">
                <label asp-for="ItemID" class="control-label"></label>
                <select asp-for="ItemID" class="form-control" asp-items="ViewBag.ItemID"></select>
                <span asp-validation-for="ItemID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="StockTag" class="control-label"></label>
                <input asp-for="StockTag" class="form-control" />
                <span asp-validation-for="StockTag" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="create-btn" />
            </div>
        </form>
    </div>
</div>

<div class="center">
    <a asp-action="Index">Go back</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
