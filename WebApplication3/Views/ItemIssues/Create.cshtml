@model WebApplication3.Models.ItemIssue

@{
    ViewData["Title"] = "Create";
}

<section class="center text-center">
    <h1>Create</h1>

    <h4>ItemIssue</h4>

    <div class="row">
        <div class="col-md-4 center">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="Issue" class="control-label"></label>
                    <select asp-for="IssueID" class="form-control" asp-items="ViewBag.IssueID"></select>
                    <span asp-validation-for="IssueID" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Stock" class="control-label"></label>
                    <select asp-for="StockID" class="form-control" asp-items="ViewBag.StockID"></select>
                    <span asp-validation-for="StockID" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Note" class="control-label"></label>
                    <input asp-for="Note" class="form-control" />
                    <span asp-validation-for="Note" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="DateReturned" class="control-label"></label>
                    <input asp-for="DateReturned" type="date" class="form-control" />
                    <span asp-validation-for="DateReturned" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <input type="submit" value="Create" class="create-btn" />
                </div>
            </form>
        </div>
    </div>

    <div>
        <a asp-action="Index">Go back</a>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
