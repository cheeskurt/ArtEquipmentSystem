@model IEnumerable<WebApplication3.Models.ItemIssue>

@{
    ViewData["Title"] = "Issued Items";
}

<h1>Issued Items</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Issue)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Stock)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Note)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DateReturned)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Issue.IssueID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Stock.StockTag)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Note)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DateReturned)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ItemIssueID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.ItemIssueID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.ItemIssueID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
